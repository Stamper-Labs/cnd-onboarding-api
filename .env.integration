# using Testcontainers to ensure each test runs against an isolated DynamoDB instance.
DYNAMO_ENDPOINT=http://localhost:8000
DYNAMO_ACCESS_KEY_ID=fake
DYNAMO_SECRET_ACCESS_KEY=fake
DYNAMO_TABLE_NAME=cnd-onboarding-api-tb-int-test

LOG_LEVEL=debug